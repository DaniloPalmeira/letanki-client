# Saida de compilacao: obj\ e o SWF intermediario, build\ e o cliente
# montado, dist\ e o instalador.
/obj/
/build/
/dist/

# Certificado auto assinado do adt: descartavel, mas fixo para o META-INF nao
# mudar a cada build. Apagar so troca a identidade -- ela nao vale nada mesmo.
/adt-cert.p12

# SDK do Flex: ~30 MB de terceiros, resolvido por $env:FLEX_SDK ou junction
/tools/

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# IDEs
.idea/
.vscode/
.fdt/
.settings/
.actionScriptProperties
.flexProperties
.project
